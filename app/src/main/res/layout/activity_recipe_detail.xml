<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Recipe 🌸"
            android:textColor="#8E5A80"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/textDetailRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textColor="#8E5A80"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/textDetailPrepTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation time: 0 minutes"
            android:textColor="#806D7B"
            android:textSize="16sp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients 🥚"
            android:textColor="#A45B8D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/textDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe ingredients will appear here."
            android:textColor="#594650"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:padding="14dp"
            android:background="#FCEAF4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking Instructions 👩‍🍳"
            android:textColor="#A45B8D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/textDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking instructions will appear here."
            android:textColor="#594650"
            android:textSize="16sp"
            android:lineSpacingExtra="8dp"
            android:padding="14dp"
            android:background="#FCEAF4" />

        <Button
            android:id="@+id/buttonBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Recipes 💗"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D99BC2"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
