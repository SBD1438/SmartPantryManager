<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="3dp">

    <TextView
        android:id="@+id/textRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe Name"
        android:textColor="#8E5A80"
        android:textSize="19sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/textRecipePrepTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparation time: 15 minutes"
        android:textColor="#806D7B"
        android:textSize="14sp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/textRecipeTap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to view recipe and instructions →"
        android:textColor="#B36B9B"
        android:textSize="14sp" />


</LinearLayout>
